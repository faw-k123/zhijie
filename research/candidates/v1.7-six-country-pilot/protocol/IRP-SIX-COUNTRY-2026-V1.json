  "design": {
    "type": "between_subject_single_version",
    "description": "每名参与者随机分配一首曲目和一个版本；原版/适配版按国家×曲目配额平衡。",
    "randomization": "SHA-256(seed|protocol|participant|country) 确定性分配；保存 seed 与分配日志。",
    "order_balance": "本轮为组间单版本设计；不以同一参与者内顺序平衡冒充组内对照。"
  },
  "targets": {
    "per_variant_per_cell": 20,
    "per_cell": 40,
    "per_country_total": 120,
    "per_country_cells": 12
  },
  "inclusion": [
    "年满18岁并完成研究同意",
    "能够使用所在国语言完成问卷",
    "完成至少一次完整试听并提交"
  ],
  "exclusion": [
    "未同意",
    "重复 participant 编号",
    "完成率低于 70%",
    "缺失任一必填八项测量且无合规缺失规则",
    "试运行/演示数据"
  ],
  "measurement": {
    "items": [
      {
        "id": "emotional_resonance",
        "label": "情绪共鸣",
        "source": "audience",
        "prompt_zh": "这段音乐在多大程度上触动了你的情绪？",
        "anchor_1": "完全没有情绪反应",
        "anchor_5": "强烈触动，愿意继续听或分享",
        "reverse": false,
        "required": true
      },
      {
        "id": "timbre_identity",
        "label": "音色辨识",
        "source": "audience",
        "prompt_zh": "你能多清楚地辨认出这种乐器/声音的独特音色？",
        "anchor_1": "听不出独特音色",
        "anchor_5": "音色非常独特且能描述",
        "reverse": false,
        "required": true
      },
      {
        "id": "melody_accessibility",
        "label": "旋律可进入性",
        "source": "audience",
        "prompt_zh": "旋律对你来说有多容易跟随和记住？",
        "anchor_1": "难以跟随或记住",
        "anchor_5": "很容易跟随，能哼出片段",
        "reverse": false,
        "required": true
      },
      {
        "id": "cultural_story",
        "label": "文化故事性",
        "source": "audience",
        "prompt_zh": "音乐和导赏让你理解了多少背后的文化故事？",
        "anchor_1": "完全没有理解",
        "anchor_5": "能清楚复述故事和背景",
        "reverse": false,
        "required": true
      },
      {
        "id": "adaptation_space",
        "label": "跨文化改编空间",
        "source": "audience",
        "prompt_zh": "你觉得这种音乐与当地音乐元素结合的空间有多大？",
        "anchor_1": "完全不适合结合",
        "anchor_5": "结合自然，愿意听更多",
        "reverse": false,
        "required": true
      },
      {
        "id": "visual_expressiveness",
        "label": "视觉表现力",
        "source": "audience",
        "prompt_zh": "提供的视觉呈现与音乐有多匹配、多有表现力？",
        "anchor_1": "视觉与音乐不匹配或没有视觉材料",
        "anchor_5": "视觉显著增强音乐表现",
        "reverse": false,
        "required": true,
        "no_visual_rule": "没有视觉材料时记 missing，不补 3 分"
      },
      {
        "id": "era_theme_relevance",
        "label": "时代主题相关性",
        "source": "audience",
        "prompt_zh": "音乐与导赏提出的当代主题有多相关？",
        "anchor_1": "看不出关联",
        "anchor_5": "关联清晰且与我的当代经验相连",
        "reverse": false,
        "required": true
      },
      {
        "id": "existing_evidence",
        "label": "既有传播证据",
        "source": "researcher_evidence",
        "prompt_zh": "由研究人员依据来源编码，不向受众提问",
        "anchor_1": "无可核实传播证据",
        "anchor_5": "多来源、持续、可核实的传播记录",
        "reverse": false,
        "required": true
      }
    ],
    "auxiliary": [
      {
        "id": "prior_exposure",
        "label": "既往中国音乐接触",
        "values": [
          "none",
          "limited",
          "familiar"
        ]
      },
      {
        "id": "save_share_intent",
        "label": "收藏/分享意愿",
        "scale": "1—5"
      },
      {
        "id": "learning_intent",
        "label": "学习参与意愿",
        "scale": "1—5"
      },
      {
        "id": "open_response",
        "label": "开放回答",
        "type": "text"
      }
    ],
    "scale": "前七项 1—5；既有证据 0—100；正式聚合统一转 0—100",
    "reverse": "本版本无反向题；若新增反向题，必须在编码规则中先反向计分再转换",
    "missing": "缺失不补 3 分；视觉材料缺失时 visual_expressiveness 记 missing；任一必填项缺失则不进入正式评分",
    "no_visual_rule": "无适用视觉材料时 visual_expressiveness 保持 null，不补分"
  },
  "formula": {
    "survey_conversion": "(mean_1_5 - 1) / 4 × 100",
    "score": "Σ(survey_100_i × 0.125) + evidence_0_100 × 0.125",
    "range": "0—100；越界报错，不截断",
    "evidence": "必须来自经审批证据分，不由受众填写"
  },
  "analysis": {
    "within_country": "按国家×曲目×版本统计 n、均值、标准差、有效率、原版/适配差异",
    "cross_country": "先国家内聚合，再对国家等权；权重规则须在评分版本中固定",
    "ranking": "只有 active/published 版本且八项完整的单元进入排名"
  },
