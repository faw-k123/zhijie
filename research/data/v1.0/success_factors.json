{
  "schema_version": "1.0.0",
  "data_version": "v1.0",
  "indicators": [
    {
      "indicator_id": "emotional_resonance",
      "label_zh": "情感共通性",
      "order": 1,
      "definition": "作品是否能触发跨语言的情绪共鸣（喜悦、乡愁、悲怆、壮阔等），并有受众层面的证据。",
      "anchors": {
        "0": "无任何受众情感反应证据，或作品明显依赖语言/文化背景才能理解。",
        "1": "仅演奏者或媒体转述情感，缺少受众原话。",
        "2": "有1—4条受众情感反应原文（非媒体概括）。",
        "3": "≥5条受众情感反应原文，且跨越不同语言/国家，或出现“流泪/共鸣/治愈”等明确表述。"
      },
      "evidence_rule": "受众评论原文、采访中的受众引述；媒体形容词不计。"
    },
    {
      "indicator_id": "timbre_identity",
      "label_zh": "音色辨识度",
      "order": 2,
      "definition": "乐器音色本身是否被受众或演奏者作为记忆点明确提出。",
      "anchors": {
        "0": "材料中完全没有关于音色/音质的描述。",
        "1": "只有演奏者自述被音色吸引，无受众侧证据。",
        "2": "演奏者自述 + 1—4条受众提到音色。",
        "3": "演奏者自述 + ≥5条受众明确提到音色，或有专业评论分析其音色特征。"
      },
      "evidence_rule": "采访原话、受众评论；不得由研究者自行判断“音色好听”。"
    },
    {
      "indicator_id": "story_explainability",
      "label_zh": "故事可解释性",
      "order": 3,
      "definition": "该案例是否能被讲成一个可跨文化理解的故事（学习动机、文化背景、人物经历）。",
      "anchors": {
        "0": "只有演出记录，无可叙述的背景。",
        "1": "有简短背景，但缺少动机或文化解释。",
        "2": "有明确的学习/接触动机叙述，且可核验。",
        "3": "动机 + 文化背景 + 传播过程构成完整叙事，且有原文支撑。"
      },
      "evidence_rule": "采访、人物报道、节目单介绍。"
    },
    {
      "indicator_id": "cross_cultural_adaptation",
      "label_zh": "跨文化改编程度",
      "order": 4,
      "definition": "是否对曲目、编制、演奏方式做了跨文化处理。",
      "anchors": {
        "0": "完全按中国传统方式演奏传统曲目，无改编。",
        "1": "轻微调整（如加字幕、加讲解）。",
        "2": "曲目或编制有明显跨文化选择（如用二胡演奏西方影视配乐）。",
        "3": "系统性改编：跨文化曲目 + 编制/风格重构，且有公开作品可核验。"
      },
      "evidence_rule": "视频、专辑、节目单。"
    },
    {
      "indicator_id": "education_support",
      "label_zh": "教育支持程度",
      "order": 5,
      "definition": "是否有稳定的教学、课程、学位项目或工作坊支撑。",
      "anchors": {
        "0": "无教学行为。",
        "1": "零散个别授课，无公开记录。",
        "2": "有公开的持续教学记录（定期授课、系列工作坊）。",
        "3": "进入学校课程/学位项目，或形成机构化教学体系。"
      },
      "evidence_rule": "官网课程页、招生页、校方报道、公开课表。"
    },
    {
      "indicator_id": "bridge_role",
      "label_zh": "外国演奏者的文化桥梁作用",
      "order": 6,
      "definition": "演奏者是否在机构或公共层面承担了连接两种文化的中介角色。",
      "anchors": {
        "0": "无相关证据。",
        "1": "仅自我表述“桥梁”，无外部印证。",
        "2": "有媒体报道或机构承认其中介作用。",
        "3": "形成机构化/长期化的合作项目、驻场、联合演出机制。"
      },
      "evidence_rule": "报道表述、机构合作页面、项目记录。"
    },
    {
      "indicator_id": "audience_participation",
      "label_zh": "受众参与度",
      "order": 7,
      "definition": "受众是否从“观看”进入“互动/学习/再创作”。",
      "anchors": {
        "0": "无互动证据。",
        "1": "仅有播放/点赞等单向数据。",
        "2": "有评论互动，或有现场互动环节记录。",
        "3": "出现翻奏、教学、二创等由受众发起的再生产行为。"
      },
      "evidence_rule": "评论区、现场记录、二创链接。"
    },
    {
      "indicator_id": "channel_fit",
      "label_zh": "传播渠道适配度",
      "order": 8,
      "definition": "所选渠道与该乐器/作品的呈现方式是否匹配。",
      "anchors": {
        "0": "渠道与内容明显不匹配（如纯音频平台展示视觉性乐器）。",
        "1": "渠道单一且证据薄弱。",
        "2": "渠道与内容匹配，且有稳定输出。",
        "3": "多渠道协同（线上+线下+教育），且各渠道均有可核验记录。"
      },
      "evidence_rule": "账号主页、演出记录、课程页。"
    },
    {
      "indicator_id": "era_theme_relevance",
      "label_zh": "时代主题关联度",
      "order": 9,
      "definition": "与和平、文明交流、生态、非遗、青年交流、乡愁、数字文化等主题的关联强度。",
      "anchors": {
        "0": "无关联表述。",
        "1": "可间接关联，但材料中无表述。",
        "2": "材料中有明确主题表述（如“文化交流”“青年传承”）。",
        "3": "主题被机构/媒体作为核心叙事，且有具体行动支撑。"
      },
      "evidence_rule": "报道主题、活动定位、机构项目说明。"
    },
    {
      "indicator_id": "sustainability",
      "label_zh": "传播持续性",
      "order": 10,
      "definition": "传播是否跨越单次事件，形成持续输出。",
      "anchors": {
        "0": "单次事件，无后续。",
        "1": "有后续但间隔长、无稳定节奏。",
        "2": "持续1—2年以上的稳定输出。",
        "3": "持续3年以上，或形成系列化/年度化机制。"
      },
      "evidence_rule": "账号发布记录、演出年表、年度活动页面。"
    }
  ],
